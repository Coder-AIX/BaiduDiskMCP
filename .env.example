# 服务监听端口
# Docker Compose 的宿主机映射端口也读取此值
PORT=3000

# 监听地址，0.0.0.0 表示允许局域网内成员访问
HOST=0.0.0.0

# 请求体大小上限，由 adapter-node 读取
# 必须大于数据库设置中的 max_upload_size，建议留 1GB 余量
BODY_SIZE_LIMIT=3G

# SQLite 数据库文件路径
DB_PATH=./data/app.db

# 对外访问地址，用于生成上传/下载短链
# 必须是成员可以访问到的地址，例如部署后的域名或局域网 IP
# Docker、局域网或反向代理部署时必须同步修改
APP_BASE_URL=http://localhost:3000

# 百度网盘 access_token
# 首次启动时作为种子写入数据库，之后以管理端设置为准
BAIDU_ACCESS_TOKEN=

# 外部百度授权页链接（可选，仅用于管理端跳转）
BAIDU_AUTHORIZE_URL=https://openapi.baidu.com/oauth/2.0/authorize?response_type=token&client_id=QHOuRXiepJBMjtk0esLhrPoNlQyYd0mF&redirect_uri=oob&scope=basic,netdisk&qrcode=1
