{
    "name": "studio-drive",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "start": "node --env-file=.env build",
        "package:win": "node scripts/package-win.mjs",
        "package:linux": "node scripts/package-posix.mjs --target linux",
        "package:macos": "node scripts/package-posix.mjs --target macos",
        "package:linux:docker": "node scripts/package-linux-docker.mjs x64",
        "package:linux:docker:arm64": "node scripts/package-linux-docker.mjs arm64",
        "docker:build": "docker build -t studio-drive:latest .",
        "docker:up": "docker compose up -d --build",
        "docker:down": "docker compose down"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.20.0",
        "better-sqlite3": "^12.0.0",
        "busboy": "^1.6.0",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "^5.2.0",
        "@sveltejs/kit": "^2.20.0",
        "@sveltejs/vite-plugin-svelte": "^6.0.0",
        "svelte": "^5.20.0",
        "vite": "^7.0.0"
    }
}
